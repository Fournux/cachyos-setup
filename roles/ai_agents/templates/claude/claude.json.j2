{# Same format as Claude Code (2 spaces, key order kept, UTF-8, no final newline), so its rewrites are not reported as changes. This file must not end with a newline. #}
{% set current_config = ai_agents_claude_config.content | default('e30=') | b64decode | from_json %}
{% set context7 = {'type': 'http', 'url': 'https://mcp.context7.com/mcp'} %}
{% if ai_agents_context7_api_key is defined and ai_agents_context7_api_key | length > 0 %}
{% set context7 = context7 | combine({'headers': {'Authorization': 'Bearer ' ~ ai_agents_context7_api_key}}) %}
{% endif %}
{% set servers = {
  'serena': {
    'type': 'stdio',
    'command': 'serena',
    'args': ['start-mcp-server', '--context=claude-code', '--project-from-cwd']
  },
  'context7': context7
} %}
{{ current_config | combine({'mcpServers': current_config.get('mcpServers', {}) | combine(servers)}) | to_nice_json(indent=2, sort_keys=false, ensure_ascii=false) }}