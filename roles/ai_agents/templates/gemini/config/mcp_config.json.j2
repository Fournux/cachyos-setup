{
  "mcpServers": {
    "serena": {
      "args": [
        "start-mcp-server",
        "--context=antigravity",
        "--project-from-cwd"
      ],
      "command": "serena",
      "disabled": false
    },
    "context7": {
      "disabled": false,
{% if ai_agents_context7_api_key is defined and ai_agents_context7_api_key | length > 0 %}
      "headers": {
        "Authorization": "Bearer {{ ai_agents_context7_api_key }}"
      },
{% endif %}
      "serverUrl": "https://mcp.context7.com/mcp"
    }
  }
}
