[org/gnome/desktop/input-sources]
sources=[('xkb', 'fr+azerty')]

[org/gnome/desktop/interface]
show-battery-percentage=true
color-scheme='prefer-dark'
clock-show-weekday=true
cursor-size=24
document-font-name='FreeSans 12'
enable-animations=true
enable-hot-corners=false
font-antialiasing='grayscale'
font-hinting='slight'
font-name='FreeSans 12'
gtk-theme='Adwaita'
icon-theme='Papirus'
monospace-font-name='Inconsolata Medium 14'
text-scaling-factor=1.0
toolkit-accessibility=false


[org/gnome/desktop/wm/preferences]
action-middle-click-titlebar='none'
button-layout='appmenu:minimize,maximize,close'
num-workspaces=1
titlebar-font='FreeSans 12'

[org/gnome/settings-daemon/plugins/color]
night-light-schedule-automatic=false

[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'
power-button-action='interactive'


[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=@as []

[org/gnome/mutter]
edge-tiling=true
attach-modal-dialogs=true
center-new-windows=true
dynamic-workspaces=false
experimental-features=['variable-refresh-rate', 'scale-monitor-framebuffer', 'xwayland-native-scaling']
overlay-key='Super_L'

[org/gnome/shell]
favorite-apps=['opera.desktop', 'org.gnome.Nautilus.desktop', 'discord.desktop', 'code.desktop', 'firefox.desktop', 'io.gitlab.news_flash.NewsFlash.desktop', 'com.mitchellh.ghostty.desktop', 'io.missioncenter.MissionCenter.desktop', 'steam.desktop']
enabled-extensions=[{% for uuid in gnome_extensions | selectattr('enabled', 'equalto', true) | map(attribute='uuid') %}'{{ uuid }}'{% if not loop.last %}, {% endif %}{% endfor %}]
last-selected-power-profile='performance'
remember-mount-password=false

[org/gnome/shell/extensions/just-perfection]
clock-menu=true
panel-in-overview=true
startup-status=0

[org/gnome/shell/extensions/appindicator]
icon-brightness=0.0
icon-contrast=0.0
icon-opacity=240
icon-saturation=0.0
icon-size=22

[org/gnome/shell/extensions/vitals]
hot-sensors=['_temperature_k10temp_tctl_']
show-fan=false
show-memory=false
show-network=false
show-processor=false
show-storage=false
show-system=false
show-voltage=false

[org/gnome/shell/extensions/dash-to-panel]
appicon-margin=0
appicon-padding=8
dot-color-dominant=true
dot-color-override=false
dot-color-unfocused-different=false
dot-position='BOTTOM'
dot-size=4
dot-style-focused='DOTS'
dot-style-unfocused='DOTS'
focus-highlight-dominant=true
hide-overview-on-startup=true
hotkeys-overlay-combo='TEMPORARILY'
intellihide=false
leftbox-padding=int32 -1
panel-anchors='{"0":"MIDDLE","1":"MIDDLE"}'
panel-element-positions='{"0":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"rightBox","visible":true,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedBR"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}],"1":[{"element":"showAppsButton","visible":false,"position":"stackedTL"},{"element":"activitiesButton","visible":false,"position":"stackedTL"},{"element":"rightBox","visible":true,"position":"stackedTL"},{"element":"leftBox","visible":true,"position":"stackedBR"},{"element":"taskbar","visible":true,"position":"centerMonitor"},{"element":"centerBox","visible":true,"position":"stackedBR"},{"element":"systemMenu","visible":true,"position":"stackedBR"},{"element":"dateMenu","visible":true,"position":"stackedBR"},{"element":"desktopButton","visible":true,"position":"stackedBR"}]}'
panel-element-positions-monitors-sync=true
panel-lengths='{"0":100,"1":100}'
panel-positions='{"0":"BOTTOM"}'
panel-sizes='{"0":48,"1":48}'
primary-monitor=uint32 0
show-favorites=true
show-favorites-all-monitors=true
show-tooltip=false
status-icon-padding=2
trans-bg-color='#000000'
trans-dynamic-anim-target=0.69999999999999996
trans-panel-opacity=0.40000000000000002
trans-use-custom-bg=true
trans-use-custom-opacity=true
trans-use-dynamic-opacity=true
tray-padding=-1
window-preview-title-position='TOP'
