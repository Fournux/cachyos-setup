[[lsp_servers]]
language_id = "csharp"
command = "roslyn-language-server"
args = [
    "--stdio",
    "--logLevel",
    "Information",
    "--extensionLogDirectory",
    "/tmp",
]
file_patterns = ["**/*.cs"]
timeout_seconds = 60
request_timeout_seconds = 60

[lsp_servers.env]
DOTNET_ROOT = "{{ ansible_facts.env.HOME }}/.dotnet"

[lsp_servers.heuristics]
project_markers = [
    "*.sln",
    "*.slnx",
    "*.csproj",
    "Directory.Build.props",
    "Directory.Packages.props",
    "global.json",
]
