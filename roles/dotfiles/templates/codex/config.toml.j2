model = "gpt-6-astra"
model_reasoning_effort = "high"

[tui]
status_line = [
  "model-with-reasoning",
  "current-dir",
  "git-branch",
  "context-used",
  "context-window-size",
]
status_line_use_colors = true

[features]
plugin_hooks = true
hooks = true

[mcp_servers.serena]
command = "serena"
args = [
  "start-mcp-server",
  "--context=codex",
  "--project-from-cwd",
]

[mcp_servers.context7]
url = "https://mcp.context7.com/mcp"
{% if dotfiles_context7_api_key is defined and dotfiles_context7_api_key | length > 0 %}

[mcp_servers.context7.http_headers]
Authorization = "Bearer {{ dotfiles_context7_api_key }}"
{% endif %}

[marketplaces.i-have-adhd]
source_type = "git"
source = "https://github.com/ayghri/i-have-adhd.git"
ref = "main"

[plugins."i-have-adhd@i-have-adhd"]
enabled = true

