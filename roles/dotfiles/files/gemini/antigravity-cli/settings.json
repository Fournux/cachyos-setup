{
  "agentMode": "accept-edits",
  "allowNonWorkspaceAccess": true,
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "permissions": {
    "allow": [
      "command(*)",
      "read_url(*)",
      "mcp(*)",
      "write_file(*)"
    ],
    "deny": [
      "command(sudo)",
      "command(su)",
      "command(rm -rf /)",
      "command(rm -rf /*)",
      "command(rm -rf ~)",
      "command(rm -rf ~/*)",
      "command(mkfs.*)",
      "command(dd)",
      "command(shutdown)",
      "command(reboot)"
    ]
  },
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh",
    "enabled": true
  }
}
